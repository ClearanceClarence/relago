{
  "name": "relago",
  "version": "1.0.0",
  "description": "Relative time in under 1 kB, every language included: \"3 days ago\", \"in 4 hours\", \"yesterday\". Zero dependencies, built on Intl.RelativeTimeFormat.",
  "keywords": [
    "relative time",
    "time ago",
    "timeago",
    "from now",
    "fromNow",
    "ago",
    "relative date",
    "humanize",
    "intl",
    "RelativeTimeFormat",
    "i18n",
    "date",
    "time",
    "tiny",
    "zero-dependency",
    "moment",
    "dayjs"
  ],
  "license": "MIT",
  "author": "ClearanceClarence",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=14"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --minify --clean",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run build && npm run coverage",
    "prepublishOnly": "npm run check",
    "compare": "npm --prefix bench install && npm --prefix bench run compare"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "@vitest/coverage-v8": "^5.1.1",
    "tsup": "^9.0.0",
    "typescript": "^5.4.0",
    "vitest": "^5.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ClearanceClarence/relago.git"
  },
  "homepage": "https://github.com/ClearanceClarence/relago#readme",
  "bugs": {
    "url": "https://github.com/ClearanceClarence/relago/issues"
  }
}
